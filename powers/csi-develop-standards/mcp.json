{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "aws-docs": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "awslabs.aws-documentation-mcp-server@latest"
            ],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR",
                "AWS_DOCUMENTATION_PARTITION": "aws"
            }
        },
        "aws-pricing": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "awslabs.aws-pricing-mcp-server@latest"
            ],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR",
                "AWS_PROFILE": "AdministratorAccess-962682390364",
                "AWS_REGION": "us-east-1"
            }
        },
        "drawio-architect": {
            "type": "stdio",
            "command": "aim",
            "args": [
                "mcp",
                "start-server",
                "drawio-architect-mcp"
            ],
            "env": {
                "DRAWIO_FILES_ROOT": "D:/kiro-university/csv-to-avro-api/Documents"
            }
        }
    }
}